# Hally: instancia privada de un entrenador con sus clientes.
#
# Copia este archivo a ".env" y ajusta el dominio. Con Docker lo lee `docker compose`
# (env_file); sin Docker el API no lee .env por sí solo, así que las mismas variables van
# en el entorno del proceso (ver docs/hally/README.md).
#
# Todas las variables de upstream siguen valiendo y están explicadas en .env.example.
# Aquí solo están las que cambian para Hally.

# ── Dominio ────────────────────────────────────────────────────────────────
# Las passkeys quedan atadas a RP_ID: fíjalo ANTES de dar de alta clientes. Cambiarlo
# después invalida todas las passkeys. Tiene que ser HTTPS (localhost es la excepción).
#
#   RP_ID=hally.example.com
#   ORIGIN=https://hally.example.com
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=Hally

# ── Instancia privada ──────────────────────────────────────────────────────
# El primer perfil que se crea queda como admin: Pedro crea el suyo antes de compartir
# la dirección. Después el admin se marca a sí mismo como entrenador en Admin.
FIRST_USER_ADMIN=1

# Un perfil nuevo necesita un código de invitación. El código que crea un entrenador
# liga al perfil nuevo con ese entrenador (el código es el consentimiento).
INVITE_ONLY=1

# Sin "Continuar sin cuenta": un cliente siempre entra con su perfil.
ALLOW_GUEST=0

# Usuario y contraseña junto a las passkeys. Hace falta para navegadores embebidos y
# para recuperar la cuenta de un cliente con un código de restablecimiento desde Admin.
PASSWORD_LOGIN=1

# La pantalla de entrada y los perfiles nuevos arrancan en español.
DEFAULT_LANG=es
